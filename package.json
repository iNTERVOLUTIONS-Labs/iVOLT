{
  "name": "ivolt-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @intervolutions/ivolt",
    "test": "vitest run",
    "test:browser": "playwright test",
    "sizes": "node packages/ivolt/scripts/sizes.mjs",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "check-examples": "node scripts/check-examples.mjs",
    "dev:docs": "node apps/docs/scripts/prebuild.mjs && npm run dev -w docs",
    "build:docs": "node scripts/ensure-dist.mjs && npm run build -w docs",
    "verify": "npm run build && npm test && IVOLT_ALL_BROWSERS=1 npm run test:browser && npm run sizes && npm run pack-smoke && npm run build:docs && npm run check-examples"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "browserslist": "^4.29.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.6.0",
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  }
}
