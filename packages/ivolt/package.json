{
  "name": "@intervolutions/ivolt",
  "version": "0.9.0-beta.0",
  "description": "A hybrid CSS/HTML/JS frontend framework: semantic components, a finite utility set, design tokens and optional JavaScript.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/js/auto.js",
    "./dist/js/ivolt.iife.min.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./auto": {
      "types": "./dist/types/auto.d.ts",
      "default": "./dist/js/auto.js"
    },
    "./theme": {
      "types": "./dist/types/theme.d.ts",
      "default": "./dist/js/theme.js"
    },
    "./dialog": {
      "types": "./dist/types/components/dialog.d.ts",
      "default": "./dist/js/components/dialog.js"
    },
    "./disclosure": {
      "types": "./dist/types/components/disclosure.d.ts",
      "default": "./dist/js/components/disclosure.js"
    },
    "./tabs": {
      "types": "./dist/types/components/tabs.d.ts",
      "default": "./dist/js/components/tabs.js"
    },
    "./dropdown": {
      "types": "./dist/types/components/dropdown.d.ts",
      "default": "./dist/js/components/dropdown.js"
    },
    "./drawer": {
      "types": "./dist/types/components/drawer.d.ts",
      "default": "./dist/js/components/drawer.js"
    },
    "./toast": {
      "types": "./dist/types/components/toast.d.ts",
      "default": "./dist/js/components/toast.js"
    },
    "./combobox": {
      "types": "./dist/types/components/combobox.d.ts",
      "default": "./dist/js/components/combobox.js"
    },
    "./datatable": {
      "types": "./dist/types/components/datatable.d.ts",
      "default": "./dist/js/components/datatable.js"
    },
    "./picker": {
      "types": "./dist/types/components/picker.d.ts",
      "default": "./dist/js/components/picker.js"
    },
    "./carousel": {
      "types": "./dist/types/components/carousel.d.ts",
      "default": "./dist/js/components/carousel.js"
    },
    "./form": {
      "types": "./dist/types/components/form.d.ts",
      "default": "./dist/js/components/form.js"
    },
    "./counter": {
      "types": "./dist/types/components/counter.d.ts",
      "default": "./dist/js/components/counter.js"
    },
    "./megamenu": {
      "types": "./dist/types/components/megamenu.d.ts",
      "default": "./dist/js/components/megamenu.js"
    },
    "./proximity": {
      "types": "./dist/types/components/proximity.d.ts",
      "default": "./dist/js/components/proximity.js"
    },
    "./reveal": {
      "types": "./dist/types/components/reveal.d.ts",
      "default": "./dist/js/components/reveal.js"
    },
    "./datepicker": {
      "types": "./dist/types/components/datepicker.d.ts",
      "default": "./dist/js/components/datepicker.js"
    },
    "./tooltip": {
      "types": "./dist/types/components/tooltip.d.ts",
      "default": "./dist/js/components/tooltip.js"
    },
    "./popover": {
      "types": "./dist/types/components/popover.d.ts",
      "default": "./dist/js/components/popover.js"
    },
    "./command": {
      "types": "./dist/types/components/command.d.ts",
      "default": "./dist/js/components/command.js"
    },
    "./navbar": {
      "types": "./dist/types/components/navbar.d.ts",
      "default": "./dist/js/components/navbar.js"
    },
    "./stepper": {
      "types": "./dist/types/components/stepper.d.ts",
      "default": "./dist/js/components/stepper.js"
    },
    "./lightbox": {
      "types": "./dist/types/components/lightbox.d.ts",
      "default": "./dist/js/components/lightbox.js"
    },
    "./scroll-motion": {
      "types": "./dist/types/components/scroll-motion.d.ts",
      "default": "./dist/js/components/scroll-motion.js"
    },
    "./countup": {
      "types": "./dist/types/components/countup.d.ts",
      "default": "./dist/js/components/countup.js"
    },
    "./iife": "./dist/js/ivolt.iife.min.js",
    "./css/*": "./dist/css/*",
    "./tokens.json": "./dist/tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs && node scripts/build-utilities.mjs && node scripts/build-css.mjs && node scripts/build-js.mjs && node scripts/build-types.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/build-utilities.mjs && node scripts/build-css.mjs",
    "build:js": "node scripts/build-js.mjs && node scripts/build-types.mjs",
    "sizes": "node scripts/sizes.mjs"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "samsung >= 22"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iNTERVOLUTIONS-Labs/iVOLT.git"
  },
  "keywords": [
    "css",
    "framework",
    "components",
    "design-tokens",
    "accessibility"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
