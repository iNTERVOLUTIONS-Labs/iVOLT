{
  "$schema": "./tokens.schema.md",
  "palette": {
    "green": {
      "50": "#E8FDF3",
      "100": "#C6F9E1",
      "200": "#93F3C6",
      "300": "#5CF0AE",
      "400": "#29F59A",
      "500": "#14D882",
      "600": "#0FB56C",
      "700": "#0B8A55",
      "800": "#0A6A43",
      "900": "#084D32",
      "950": "#04301F"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F3FAF6",
      "100": "#E4EDE8",
      "200": "#CBD8D1",
      "300": "#A9B9B1",
      "400": "#90A49E",
      "500": "#6E837B",
      "600": "#56695F",
      "700": "#3F4F47",
      "800": "#263129",
      "900": "#12201A",
      "950": "#081310",
      "1000": "#030806"
    },
    "red": {
      "50": "#FDECEC",
      "300": "#FF7A80",
      "600": "#B2262D"
    },
    "amber": {
      "50": "#FFF4E0",
      "300": "#FFB84D",
      "700": "#8A5200"
    },
    "blue": {
      "50": "#E8F1FD",
      "300": "#6FB3FF",
      "600": "#1D5FB8"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.950}"
    },
    "surface": {
      "light": "{palette.neutral.50}",
      "dark": "{palette.neutral.900}"
    },
    "surface-raised": {
      "light": "{palette.neutral.0}",
      "dark": "#1B2C25"
    },
    "text": {
      "light": "{palette.neutral.900}",
      "dark": "{palette.neutral.50}"
    },
    "text-muted": {
      "light": "{palette.neutral.600}",
      "dark": "{palette.neutral.400}"
    },
    "border": {
      "light": "{palette.neutral.200}",
      "dark": "{palette.neutral.800}"
    },
    "border-strong": {
      "light": "{palette.neutral.500}",
      "dark": "{palette.neutral.500}"
    },
    "primary": {
      "light": "{palette.green.800}",
      "dark": "{palette.green.400}"
    },
    "on-primary": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.950}"
    },
    "primary-hover": {
      "light": "{palette.green.900}",
      "dark": "{palette.green.300}"
    },
    "primary-active": {
      "light": "{palette.green.950}",
      "dark": "{palette.green.500}"
    },
    "primary-subtle": {
      "light": "{palette.green.50}",
      "dark": "rgb(41 245 154 / 0.12)"
    },
    "accent": {
      "light": "{palette.green.400}",
      "dark": "{palette.green.400}"
    },
    "on-accent": {
      "light": "{palette.neutral.950}",
      "dark": "{palette.neutral.950}"
    },
    "success": {
      "light": "{palette.green.800}",
      "dark": "{palette.green.400}"
    },
    "on-success": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.950}"
    },
    "success-subtle": {
      "light": "{palette.green.50}",
      "dark": "rgb(41 245 154 / 0.12)"
    },
    "danger": {
      "light": "{palette.red.600}",
      "dark": "{palette.red.300}"
    },
    "on-danger": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.950}"
    },
    "danger-subtle": {
      "light": "{palette.red.50}",
      "dark": "rgb(255 122 128 / 0.12)"
    },
    "warning": {
      "light": "{palette.amber.700}",
      "dark": "{palette.amber.300}"
    },
    "on-warning": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.950}"
    },
    "warning-subtle": {
      "light": "{palette.amber.50}",
      "dark": "rgb(255 184 77 / 0.12)"
    },
    "info": {
      "light": "{palette.blue.600}",
      "dark": "{palette.blue.300}"
    },
    "on-info": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.950}"
    },
    "info-subtle": {
      "light": "{palette.blue.50}",
      "dark": "rgb(111 179 255 / 0.12)"
    },
    "focus": {
      "light": "{palette.green.800}",
      "dark": "{palette.green.400}"
    },
    "overlay": {
      "light": "rgb(8 19 16 / 0.55)",
      "dark": "rgb(0 0 0 / 0.6)"
    },
    "hover-surface": {
      "light": "rgb(8 19 16 / 0.04)",
      "dark": "rgb(224 255 240 / 0.05)"
    },
    "primary-border": {
      "light": "rgb(10 106 67 / 0.55)",
      "dark": "rgb(41 245 154 / 0.5)"
    }
  },
  "space": {
    "$type": "dimension",
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "text": {
    "$type": "dimension",
    "xs": "0.75rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "clamp(1.75rem, 1.2rem + 1.5vw, 2.25rem)",
    "4xl": "clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem)"
  },
  "leading": {
    "$type": "number",
    "tight": "1.1",
    "snug": "1.25",
    "normal": "1.5",
    "relaxed": "1.65"
  },
  "tracking": {
    "$type": "dimension",
    "tight": "-0.011em",
    "caps": "0.06em"
  },
  "weight": {
    "$type": "number",
    "normal": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "font": {
    "$type": "fontFamily",
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
  },
  "radius": {
    "$type": "dimension",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "full": "999rem"
  },
  "border": {
    "$type": "dimension",
    "width": "1px",
    "width-strong": "3px"
  },
  "shadow": {
    "$type": "shadow",
    "1": {
      "light": "0 1px 2px rgb(8 19 16 / 0.06)",
      "dark": "0 0 0 1px #1B2C25"
    },
    "2": {
      "light": "0 4px 12px rgb(8 19 16 / 0.10)",
      "dark": "0 4px 12px rgb(0 0 0 / 0.4)"
    },
    "3": {
      "light": "0 12px 32px rgb(8 19 16 / 0.14)",
      "dark": "0 12px 32px rgb(0 0 0 / 0.5)"
    },
    "ambient": {
      "light": "0 2px 10px rgb(8 19 16 / 0.10)",
      "dark": "0 0 0 1px #1B2C25, 0 2px 10px rgb(0 0 0 / 0.45)"
    }
  },
  "glass": {
    "$type": "color",
    "bg": {
      "light": "rgb(255 255 255 / 0.55)",
      "dark": "rgb(18 32 26 / 0.45)"
    },
    "bg-strong": {
      "light": "rgb(255 255 255 / 0.78)",
      "dark": "rgb(18 32 26 / 0.72)"
    },
    "border": {
      "light": "rgb(255 255 255 / 0.65)",
      "dark": "rgb(255 255 255 / 0.12)"
    },
    "highlight": {
      "light": "rgb(255 255 255 / 0.9)",
      "dark": "rgb(255 255 255 / 0.2)"
    }
  },
  "blur": {
    "$type": "dimension",
    "sm": "8px",
    "md": "16px",
    "lg": "28px"
  },
  "glow": {
    "$type": "color",
    "primary": {
      "light": "rgb(10 106 67 / 0.35)",
      "dark": "rgb(41 245 154 / 0.45)"
    },
    "secondary": {
      "light": "rgb(29 95 184 / 0.25)",
      "dark": "rgb(111 179 255 / 0.35)"
    }
  },
  "texture": {
    "$type": "number",
    "grain-opacity": {
      "light": "0.05",
      "dark": "0.09"
    }
  },
  "focus": {
    "$type": "dimension",
    "width": "2px",
    "offset": "2px",
    "halo": {
      "$type": "shadow",
      "light": "0 0 0 4px rgb(10 106 67 / 0.35)",
      "dark": "0 0 0 4px rgb(41 245 154 / 0.45)"
    }
  },
  "z": {
    "$type": "number",
    "dropdown": "100",
    "drawer": "200",
    "dialog": "300",
    "toast": "400"
  },
  "motion": {
    "$type": "duration",
    "fast": "120ms",
    "base": "180ms",
    "slow": "220ms"
  },
  "ease": {
    "$type": "cubicBezier",
    "out": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  },
  "measure": {
    "$type": "dimension",
    "$value": "68ch"
  },
  "content-max": {
    "$type": "dimension",
    "$value": "90rem"
  },
  "container-max": {
    "$type": "dimension",
    "$value": "75rem"
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": "30em",
    "md": "48em",
    "lg": "64em",
    "xl": "80em",
    "2xl": "90em"
  }
}
