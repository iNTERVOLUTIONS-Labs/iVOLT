{
  "$schema": "./tokens.schema.md",
  "palette": {
    "$type": "color",
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F5F7FC",
      "100": "#E9EDF7",
      "200": "#D3DAEA",
      "300": "#B3BDD4",
      "400": "#8F9BB8",
      "500": "#6B7896",
      "600": "#4F5B7A",
      "700": "#33406A",
      "800": "#1C2544",
      "900": "#0C1330",
      "950": "#070D1C",
      "1000": "#04070F"
    },
    "cobalt": {
      "50": "#EAF4FF",
      "100": "#D6E9FF",
      "200": "#B3D6FF",
      "300": "#8FC6FF",
      "400": "#66B1FF",
      "500": "#3D94FF",
      "600": "#2266D8",
      "700": "#1D4FC4",
      "800": "#1A3FA8",
      "900": "#172F7A",
      "950": "#0F1D4D"
    },
    "cyan": {
      "50": "#E6FBFF",
      "100": "#CDF6FF",
      "200": "#A6EFFF",
      "300": "#8FE3FF",
      "400": "#73DFFF",
      "500": "#3FCDF5",
      "600": "#17AAD6",
      "700": "#0E8AB0",
      "800": "#0B6B8A",
      "900": "#094D63",
      "950": "#052F3D"
    },
    "indigo": {
      "50": "#EEF0FF",
      "100": "#DFE2FF",
      "200": "#C2C8FF",
      "300": "#A4ADFF",
      "400": "#8B95FF",
      "500": "#6674FF",
      "600": "#4F5BE6",
      "700": "#3D47C2",
      "800": "#313996",
      "900": "#262C6E",
      "950": "#171A45"
    },
    "green": {
      "50": "#F1F8E4",
      "300": "#C6E28A",
      "400": "#8BBF3A",
      "700": "#4F7A12",
      "800": "#3F6110"
    },
    "red": {
      "50": "#FFF1F0",
      "300": "#FF9AA4",
      "500": "#FF665C",
      "600": "#D63A31",
      "700": "#B52D26"
    },
    "amber": {
      "50": "#FFF8E6",
      "300": "#FFE9A8",
      "400": "#FBBF24",
      "700": "#8F5C00"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.1000}"
    },
    "surface": {
      "light": "{palette.neutral.50}",
      "dark": "{palette.neutral.950}"
    },
    "surface-raised": {
      "light": "{palette.neutral.0}",
      "dark": "{palette.neutral.900}"
    },
    "text": {
      "light": "#0B1230",
      "dark": "#EEF2FB"
    },
    "text-muted": {
      "light": "{palette.neutral.600}",
      "dark": "#A8B3CC"
    },
    "border": {
      "light": "{palette.neutral.200}",
      "dark": "{palette.neutral.800}"
    },
    "border-strong": {
      "light": "{palette.neutral.500}",
      "dark": "{palette.neutral.500}"
    },
    "primary": {
      "light": "{palette.cobalt.700}",
      "dark": "{palette.cobalt.400}"
    },
    "on-primary": {
      "light": "{palette.neutral.0}",
      "dark": "#06122B"
    },
    "primary-hover": {
      "light": "{palette.cobalt.800}",
      "dark": "{palette.cobalt.300}"
    },
    "primary-active": {
      "light": "{palette.cobalt.900}",
      "dark": "{palette.cobalt.500}"
    },
    "primary-subtle": {
      "light": "{palette.cobalt.50}",
      "dark": "rgb(102 177 255 / 0.12)"
    },
    "accent": {
      "light": "{palette.cyan.800}",
      "dark": "{palette.cyan.400}"
    },
    "on-accent": {
      "light": "{palette.neutral.0}",
      "dark": "#06122B"
    },
    "success": {
      "light": "{palette.green.700}",
      "dark": "{palette.green.400}"
    },
    "on-success": {
      "light": "{palette.neutral.0}",
      "dark": "#06122B"
    },
    "success-subtle": {
      "light": "{palette.green.50}",
      "dark": "rgb(139 191 58 / 0.12)"
    },
    "danger": {
      "light": "{palette.red.600}",
      "dark": "{palette.red.300}"
    },
    "on-danger": {
      "light": "{palette.neutral.0}",
      "dark": "#06122B"
    },
    "danger-subtle": {
      "light": "{palette.red.50}",
      "dark": "rgb(255 154 164 / 0.12)"
    },
    "warning": {
      "light": "{palette.amber.700}",
      "dark": "{palette.amber.400}"
    },
    "on-warning": {
      "light": "{palette.neutral.0}",
      "dark": "#06122B"
    },
    "warning-subtle": {
      "light": "{palette.amber.50}",
      "dark": "rgb(251 191 36 / 0.12)"
    },
    "info": {
      "light": "{palette.indigo.700}",
      "dark": "{palette.indigo.400}"
    },
    "on-info": {
      "light": "{palette.neutral.0}",
      "dark": "#06122B"
    },
    "info-subtle": {
      "light": "{palette.indigo.50}",
      "dark": "rgb(139 149 255 / 0.12)"
    },
    "focus": {
      "light": "{palette.cobalt.700}",
      "dark": "{palette.cyan.400}"
    },
    "overlay": {
      "light": "rgb(11 18 48 / 0.55)",
      "dark": "rgb(2 5 12 / 0.65)"
    },
    "hover-surface": {
      "light": "rgb(11 18 48 / 0.04)",
      "dark": "rgb(230 240 255 / 0.05)"
    },
    "primary-border": {
      "light": "rgb(29 79 196 / 0.55)",
      "dark": "rgb(102 177 255 / 0.5)"
    }
  },
  "space": {
    "$type": "dimension",
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "text": {
    "$type": "dimension",
    "xs": "0.75rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "clamp(1.75rem, 1.2rem + 1.5vw, 2.25rem)",
    "4xl": "clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem)"
  },
  "leading": {
    "$type": "number",
    "tight": "1.1",
    "snug": "1.25",
    "normal": "1.5",
    "relaxed": "1.65"
  },
  "tracking": {
    "$type": "dimension",
    "tight": "-0.011em",
    "caps": "0.06em"
  },
  "weight": {
    "$type": "number",
    "normal": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "font": {
    "$type": "fontFamily",
    "sans": "\"Outfit\", \"Outfit Variable\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
  },
  "radius": {
    "$type": "dimension",
    "sm": "0.375rem",
    "md": "0.875rem",
    "lg": "1.375rem",
    "full": "999rem"
  },
  "border": {
    "$type": "dimension",
    "width": "1px",
    "width-strong": "3px"
  },
  "shadow": {
    "$type": "shadow",
    "1": {
      "light": "0 1px 2px rgb(11 18 48 / 0.06)",
      "dark": "0 0 0 1px #1C2544"
    },
    "2": {
      "light": "0 4px 12px rgb(11 18 48 / 0.10)",
      "dark": "0 4px 12px rgb(0 0 0 / 0.45)"
    },
    "3": {
      "light": "0 12px 32px rgb(11 18 48 / 0.14)",
      "dark": "0 12px 32px rgb(0 0 0 / 0.55)"
    },
    "ambient": {
      "light": "0 2px 10px rgb(11 18 48 / 0.10)",
      "dark": "0 0 0 1px #1C2544, 0 2px 10px rgb(0 0 0 / 0.5)"
    }
  },
  "glass": {
    "$type": "color",
    "bg": {
      "light": "rgb(255 255 255 / 0.55)",
      "dark": "rgb(12 19 48 / 0.5)"
    },
    "bg-strong": {
      "light": "rgb(255 255 255 / 0.78)",
      "dark": "rgb(12 19 48 / 0.78)"
    },
    "border": {
      "light": "rgb(255 255 255 / 0.65)",
      "dark": "rgb(255 255 255 / 0.1)"
    },
    "highlight": {
      "light": "rgb(255 255 255 / 0.9)",
      "dark": "rgb(255 255 255 / 0.18)"
    }
  },
  "blur": {
    "$type": "dimension",
    "sm": "8px",
    "md": "16px",
    "lg": "28px"
  },
  "glow": {
    "$type": "color",
    "primary": {
      "light": "rgb(29 79 196 / 0.35)",
      "dark": "rgb(102 177 255 / 0.45)"
    },
    "secondary": {
      "light": "rgb(11 107 138 / 0.3)",
      "dark": "rgb(115 223 255 / 0.4)"
    }
  },
  "gradient": {
    "$type": "gradient",
    "brand": {
      "light": "linear-gradient(120deg, #0B6B8A, #1D4FC4)",
      "dark": "linear-gradient(120deg, #73DFFF, #6674FF)"
    },
    "primary": {
      "light": "linear-gradient(120deg, #17AAD6, #1D4FC4 55%, #3D47C2)",
      "dark": "linear-gradient(120deg, #8FE3FF, #66B1FF 55%, #8B95FF)"
    }
  },
  "texture": {
    "$type": "number",
    "grain-opacity": {
      "light": "0.05",
      "dark": "0.09"
    }
  },
  "focus": {
    "$type": "dimension",
    "width": "2px",
    "offset": "2px",
    "halo": {
      "$type": "shadow",
      "light": "0 0 0 4px rgb(29 79 196 / 0.35)",
      "dark": "0 0 0 4px rgb(102 177 255 / 0.45)"
    }
  },
  "z": {
    "$type": "number",
    "dropdown": "100",
    "drawer": "200",
    "dialog": "300",
    "toast": "400"
  },
  "motion": {
    "$type": "duration",
    "fast": "120ms",
    "base": "180ms",
    "slow": "220ms"
  },
  "ease": {
    "$type": "cubicBezier",
    "out": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  },
  "measure": {
    "$type": "dimension",
    "$value": "68ch"
  },
  "content-max": {
    "$type": "dimension",
    "$value": "90rem"
  },
  "container-max": {
    "$type": "dimension",
    "$value": "75rem"
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": "30em",
    "md": "48em",
    "lg": "64em",
    "xl": "80em",
    "2xl": "90em"
  }
}
