---
// The hero's install box: the two ways in (CDN, npm) as tabs with a copy button, and the GitHub
// star link. The CDN lines point at jsDelivr with the major version pinned; this site itself
// never loads them (it serves its own copy), they are text for the visitor to paste.
import Code from "./Code.astro";
import { stars, shown, REPO_URL } from "../lib/github.js";
const { lang = "en" } = Astro.props;
const es = lang === "es";
const count = shown(await stars());
const cdn = `<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@intervolutions/ivolt@1/dist/css/ivolt.min.css">
<script type="module" src="https://cdn.jsdelivr.net/npm/@intervolutions/ivolt@1/dist/js/auto.js"></script>`;
const npm = `npm install @intervolutions/ivolt`;
---
<div class="docs-hero__install">
  <Code panels={[{ key: "cdn", label: "CDN", code: cdn }, { key: "npm", label: "npm", code: npm }]} label={es ? "Instalar iVOLT" : "Install iVOLT"} id="hero-install" />
  <a class="docs-star" href={REPO_URL} rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
    <span>{es ? "Dale una estrella en GitHub" : "Star on GitHub"}</span>
    {count && <span class="docs-star__count" aria-label={es ? `${count} estrellas` : `${count} stars`}>{count}</span>}
  </a>
</div>
<style>
  .docs-hero__install { display: grid; gap: var(--iv-space-3); margin-block-start: var(--iv-space-6); max-inline-size: 46rem; }
  .docs-hero__install :global(.docs-code-block) { margin: 0; }
  .docs-hero__install :global(pre) { font-size: .82rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .docs-star { justify-self: start; display: inline-flex; align-items: center; gap: .55rem; padding: .45rem .9rem; border-radius: var(--iv-radius-full); border: 1px solid var(--iv-color-border); background: color-mix(in oklab, var(--iv-color-surface) 70%, transparent); color: var(--iv-color-text); text-decoration: none; font-family: var(--docs-display); font-size: .92rem; transition: border-color var(--iv-motion-fast) var(--docs-ease), transform var(--iv-motion-fast) var(--docs-ease); }
  .docs-star:hover { border-color: var(--iv-color-primary-border); transform: translateY(-1px); }
  .docs-star svg { flex: none; }
  .docs-star__count { padding-inline-start: .55rem; border-inline-start: 1px solid var(--iv-color-border); font-variant-numeric: tabular-nums; color: var(--iv-color-text-muted); }
  @media (prefers-reduced-motion: reduce) { .docs-star { transition: none; } .docs-star:hover { transform: none; } }
</style>
