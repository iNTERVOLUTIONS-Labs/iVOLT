---
// Hero arc field. The canvas is decorative and is only mounted for fine pointers without
// prefers-reduced-motion; the static bolt below is what everyone else sees.
---
<div class="docs-arcs" aria-hidden="true" data-docs-arcs>
  <canvas aria-hidden="true"></canvas>
  <div class="docs-arcs__still">
    <svg viewBox="0 0 520 520" fill="none" aria-hidden="true" focusable="false">
      <g stroke="var(--iv-color-accent)" stroke-linecap="round" stroke-linejoin="round">
        <path d="M392 26 350 168l86-18-142 176 34-118-92 26L352 92l-64 14z" stroke-width="2" opacity=".35"/>
        <path d="M96 486l58-146-74 24 118-168-28 116 84-34-102 140 58-18z" stroke-width="2" opacity=".25"/>
        <path d="M300 34 214 214l96-22-166 300 52-186-94 34L262 96l-40 20z" stroke-width="3" opacity=".8"/>
      </g>
      <path d="M300 34 214 214l96-22-166 300 52-186-94 34L262 96l-40 20z" fill="var(--iv-color-accent)" opacity=".14"/>
      <path d="M296 60 236 204l72-16-118 236 40-150-70 26L266 110z" fill="var(--docs-arc-core)" opacity=".55"/>
    </svg>
  </div>
</div>
