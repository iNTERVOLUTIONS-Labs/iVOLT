---
import Base from "../../layouts/Base.astro";
import "../../styles/home.css";
import Stage from "../../components/Stage.astro";
import DeviceFrame from "../../components/DeviceFrame.astro";
import Arcs from "../../components/Arcs.astro";
import ThemeCut from "../../components/ThemeCut.astro";
import { families } from "../../i18n/en.js";
import { componentLabels } from "../../i18n/es.js";
import { readFileSync, existsSync } from "node:fs";
import { gzipSync } from "node:zlib";
import { resolve, dirname } from "node:path";

// Medidas reales tomadas del paquete compilado en tiempo de build (gzip nivel 9), para que los datos de la página nunca se escriban a mano.
let dir = process.cwd();
while (!existsSync(resolve(dir, "packages/ivolt/dist")) && dirname(dir) !== dir) dir = dirname(dir);
const dist = resolve(dir, "packages/ivolt/dist");
const version = JSON.parse(readFileSync(resolve(dir, "packages/ivolt/package.json"), "utf8")).version;
const esNum = (n) => String(n).replace(".", ",");
const kib = (rel) => existsSync(resolve(dist, rel)) ? (gzipSync(readFileSync(resolve(dist, rel)), { level: 9 }).length / 1024).toFixed(1) : null;
const facts = [
  { value: "0", label: "dependencias de ejecución" },
  { value: kib("css/ivolt.min.css") ? `${esNum(kib("css/ivolt.min.css"))} KiB` : "—", label: "CSS, min + gzip" },
  { value: kib("js/ivolt.iife.min.js") ? `${esNum(kib("js/ivolt.iife.min.js"))} KiB` : "—", label: "JS (IIFE), min + gzip" },
  { value: "3", label: "motores de navegador probados" },
];
const points = [
  { title: "Funciona antes que el JavaScript", text: "Los enlaces navegan, los botones actúan y los controles nativos hacen su trabajo. Los componentes de contenido no necesitan ni un script; los interactivos mejoran marcado que ya funciona y lo devuelven tal cual en destroy." },
  { title: "Un token repinta el sistema", text: "Pon --iv-color-primary o --iv-radius-md en cualquier ámbito y todos los componentes te siguen. Los temas claro, oscuro y del sistema vienen de serie y no necesitan JavaScript." },
  { title: "JavaScript solo donde se gana el sitio", text: "init idempotente, destroy limpio, eventos cancelables, patrones de teclado de la APG, sin observadores globales, sin eval e importaciones seguras al renderizar en el servidor." },
  { title: "Archivos, no una cadena de build", text: "CSS en capas y plano, una hoja por componente, módulos ES con exports reales, un IIFE con un solo global, tipos de TypeScript y los tokens en JSON." },
];
const panels = [
  { fixture: "carousel/photos", name: "Carrusel", slug: "carousel", kind: "js" },
  { fixture: "form/float", name: "Formulario", slug: "form", kind: "css" },
  { fixture: "button/variants", name: "Botón", slug: "button", kind: "css" },
  { fixture: "badge/variants", name: "Insignia", slug: "badge", kind: "css" },
  { fixture: "alert/variants", name: "Alerta", slug: "alert", kind: "css" },
  { fixture: "card/basic", name: "Tarjeta", slug: "card", kind: "css" },
  { fixture: "tabs/basic", name: "Pestañas", slug: "tabs", kind: "js" },
  { fixture: "dialog/basic", name: "Diálogo", slug: "dialog", kind: "js" },
  { fixture: "surfaces/glass", name: "Superficies", slug: "surfaces", href: "/foundations/surfaces", kind: "css" },
  { fixture: "combobox/basic", name: "Combobox", slug: "combobox", kind: "js" },
];
const reel = [
  { fixture: "button/variants", name: "Botón", slug: "button" },
  { fixture: "form/float", name: "Formulario", slug: "form" },
  { fixture: "tabs/basic", name: "Pestañas", slug: "tabs" },
  { fixture: "dialog/basic", name: "Diálogo", slug: "dialog" },
  { fixture: "combobox/basic", name: "Combobox", slug: "combobox" },
  { fixture: "carousel/photos", name: "Carrusel", slug: "carousel" },
];
const site = Astro.site ? Astro.site.href.replace(/\/$/, "") : null;
// Structured data for the two things this page really is: the project's site and its source code.
// Only facts that can be checked in the repository — name, licence, repository, languages, version.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "iVOLT",
    ...(site ? { url: `${site}/es` } : {}),
    inLanguage: "es",
    description: "Framework CSS y sistema de diseño ligero con componentes de interfaz accesibles, tokens de diseño, modo oscuro y sin dependencias de ejecución.",
    publisher: { "@type": "Organization", name: "iNTERVOLUTIONS" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "iVOLT",
    alternateName: "@intervolutions/ivolt",
    description: "Framework frontend de CSS, HTML y JavaScript opcional: 33 componentes de interfaz accesibles, un conjunto finito de utilidades, tokens de diseño, temas claro y oscuro y cero dependencias de ejecución.",
    codeRepository: "https://github.com/iNTERVOLUTIONS-Labs/iVOLT",
    programmingLanguage: ["CSS", "HTML", "JavaScript"],
    runtimePlatform: "Web browser",
    license: "https://opensource.org/licenses/MIT",
    version,
    ...(site ? { url: `${site}/es` } : {}),
    author: { "@type": "Organization", name: "iNTERVOLUTIONS" },
  },
];
const components = Object.entries(families);
const recipes = [
  { slug: "studio", title: "Studio", text: "Un estudio creativo: portada cinematográfica con parallax, marquesina, tarjetas de servicios apiladas, galería con visor y stepper de contacto." },
  { slug: "console", title: "Console", text: "Un panel de producto: megamenú, cajón, cifras con contador, tabla con filtro y orden, paleta de comandos y formulario validado." },
  { slug: "journal", title: "Journal", text: "Una revista editorial: la tipografía como protagonista, masonry de artículos, barra de lectura, notas en popovers e impresión cuidada." },
  { slug: "store", title: "Store", text: "Un catálogo y una compra que no compra nada: filtros ricos, carrusel de producto, stepper de compra, cajón de carrito y diálogo de confirmación." },
];
---
<Base lang="es" title="Framework CSS ligero y sistema de diseño" description="Framework CSS y sistema de diseño ligero: 33 componentes accesibles, tokens de diseño, modo oscuro, JavaScript opcional y cero dependencias de ejecución." sidebar={false} bleed={true}>
  <section class="docs-hero" aria-labelledby="hero-title">
    <div class="docs-orbs" aria-hidden="true"><span class="docs-orb docs-orb--a"></span><span class="docs-orb docs-orb--b"></span></div>
    <Arcs />
    <div class="docs-hero__inner">
      <p class="docs-hero__kicker">v{version.replace(/-.*$/, "")} · MIT<span class="docs-hero__kicker-tail"> · <b>cero dependencias de ejecución</b></span></p>
      <h1 class="docs-hero__title" id="hero-title">
        <span class="docs-mask" style="--i:0"><span>El framework CSS</span></span>
        <span class="docs-mask" style="--i:1"><span>sin <em>paso de build</em><span class="docs-dot">.</span></span></span>
      </h1>
      <p class="docs-hero__lead">Treinta y tres componentes accesibles, un conjunto finito de utilidades y tokens de diseño como contrato visual. Enlaza una hoja de estilo y ya estás construyendo: HTML plano, WordPress, Astro o cualquier empaquetador.</p>
      <div class="docs-hero__actions">
        <a class="iv-button iv-button--primary iv-button--lg docs-magnetic" href="/es/getting-started">Primeros pasos</a>
        <a class="iv-button iv-button--secondary iv-button--lg docs-magnetic" href="/es/components/button">Ver los componentes</a>
      </div>
      <ul class="docs-facts">
        {facts.map((f) => <li class="docs-fact"><strong class="iv-count" data-iv-component="countup">{f.value}</strong><span>{f.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="why-title">
    <div class="docs-why">
      <div class="docs-why__head">
        <span class="docs-num">01 — Por qué</span>
        <span class="docs-why__figure" aria-hidden="true">01</span>
        <h2 class="docs-why__title" id="why-title">Aprende la gramática una vez y úsala en todo.</h2>
        <p class="docs-why__lead">Cada clase, token, atributo y evento sigue el mismo contrato con prefijo, así que lo que aprendes en la primera página te sigue sirviendo en la última.</p>
      </div>
      <div class="docs-why__list">
        {points.map((p, i) => (
          <article class="docs-point docs-rail docs-reveal" style={`--i:${i}`}>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="docs-cabinet" aria-labelledby="components-title">
    <div class="docs-cabinet__head docs-wrap">
      <span class="docs-num">02 — Componentes</span>
      <h2 class="docs-why__title" id="components-title">Treinta y tres componentes,<br>vivos en esta página.</h2>
    </div>
    <div class="docs-wrap docs-showreel" data-showreel>
      <div class="docs-showreel__tabs" role="tablist" aria-label="Componentes en escena">
        {reel.map((r, i) => (
          <button class="docs-showreel__tab" type="button" role="tab" id={`reel-tab-${r.slug}`} aria-controls={`reel-panel-${r.slug}`} aria-selected={String(i === 0)} tabindex={i === 0 ? "0" : "-1"}>{r.name}</button>
        ))}
      </div>
      {reel.map((r, i) => (
        <div class="docs-showreel__panel" id={`reel-panel-${r.slug}`} role="tabpanel" aria-labelledby={`reel-tab-${r.slug}`} hidden={i !== 0}>
          <Stage name={r.fixture} title={r.name} primary={i === 0} minHeight="18rem" />
        </div>
      ))}
    </div>
    <div class="docs-wrap">
      <nav class="docs-families" aria-label="Componentes">
        {components.map(([c, kind]) => <a href={`/es/components/${c}`}>{componentLabels[c]}<small>{kind}</small></a>)}
      </nav>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="themes-title">
    <div class="docs-cutsec">
      <div class="docs-cutsec__head docs-reveal">
        <span class="docs-num">03 — Temas</span>
        <h2 class="docs-why__title" id="themes-title">El modo oscuro es un ámbito, no un interruptor.</h2>
        <p>Pon <code>data-iv-theme</code> en cualquier elemento y esa rama de la página cambia de tema. Las elecciones explícitas ganan a la preferencia del sistema, los ámbitos se anidan y nada necesita almacenamiento ni script.</p>
        <pre class="docs-code" tabindex="0"><code>&lt;html data-iv-theme="system"&gt;
  &lt;section data-iv-theme="dark"&gt;
    &lt;aside data-iv-theme="light"&gt;…&lt;/aside&gt;
  &lt;/section&gt;
&lt;/html&gt;</code></pre>
      </div>
      <div class="docs-reveal" style="--i:1">
        <ThemeCut name="theme/nested" lightLabel="claro" darkLabel="oscuro" />
        <p class="docs-cutctl">
          <label for="docs-cut-range">Mostrar el ámbito claro</label>
          <input id="docs-cut-range" type="range" min="0" max="100" value="50" step="1">
        </p>
      </div>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="recipes-title">
    <div class="docs-reveal">
      <span class="docs-num">04 — Recetas</span>
      <h2 class="docs-why__title" id="recipes-title">Cuatro páginas completas, un paquete.</h2>
    </div>
    <div class="docs-recipes" style="margin-block-start:var(--docs-rhythm-md)">
      {recipes.map((r, i) => (
        <a class="docs-recipe docs-reveal" href={`/examples/${r.slug}/index.html`}>
          <div class="docs-recipe__frame iv-edge-near"><DeviceFrame slug={r.slug} title={r.title} device="desktop" eager={i === 0} /></div>
          <div class="docs-recipe__body">
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <span class="docs-recipe__go">Abrir la receta <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="docs-invert" data-iv-theme="light" aria-labelledby="start-title">
    <div class="docs-wrap docs-invert__grid">
      <div class="docs-invert__head">
      <span class="docs-num">05 — Empezar</span>
      <h2 id="start-title">Dos archivos y ya está funcionando.</h2>
      <p>Instálalo desde npm, o copia <code>dist/</code> junto a tu página y enlaza una hoja de estilo y un módulo. Sin archivo de configuración, sin plugin y sin compilador. La plantilla inicial y las cuatro recetas son exactamente esto y nada más.</p>
      </div>
      <div class="docs-invert__side">
      <pre class="docs-code" tabindex="0"><code>npm install @intervolutions/ivolt</code></pre>
      <pre class="docs-code" tabindex="0"><code>&lt;html class="iv-root" data-iv-theme="system"&gt;
  &lt;link rel="stylesheet" href="ivolt/css/ivolt.min.css"&gt;
  &lt;script type="module" src="ivolt/js/auto.js"&gt;&lt;/script&gt;</code></pre>
      <div class="iv-cluster">
        <a class="iv-button iv-button--primary iv-button--lg docs-magnetic" href="/es/getting-started">Instalarlo ahora</a>
        <a class="iv-button iv-button--secondary iv-button--lg" href="/es/examples">Descargar la plantilla inicial</a>
      </div>
      </div>
      <p class="docs-invert__foot">v{version} con licencia MIT. Qué es público, y cómo puede cambiar, está escrito en <a href="/es/foundations/stability">estabilidad</a>. Los tamaños de arriba se miden sobre los archivos que se distribuyen, en tiempo de build.</p>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
</Base>
