---
import Base from "../../layouts/Base.astro";
const links = [
  { href: "/es", label: "Inicio", meta: "empieza aquí" },
  { href: "/es/getting-started", label: "Primeros pasos", meta: "instalación" },
  { href: "/es/components/button", label: "Componentes", meta: "33 en total" },
  { href: "/es/foundations/tokens-and-themes", label: "Tokens y temas", meta: "fundamentos" },
  { href: "/es/examples", label: "Ejemplos", meta: "4 páginas completas" },
];
---
<Base lang="es" title="Página no encontrada" description="Esta página no existe. Vuelve a la documentación de iVOLT: instalación, componentes, tokens y temas o las páginas de ejemplo." sidebar={false}>
  <article class="docs-prose">
    <div class="docs-lost">
      <div>
        <p class="docs-lost__code" aria-hidden="true">404</p>
        <h1>Página no encontrada</h1>
        <p>Ninguna página responde a esta dirección. Elige por dónde volver, o pulsa <kbd class="docs-kbd-inline">/</kbd> para buscar en la documentación.</p>
      </div>
      <nav aria-label="Vías de vuelta">
        <ul class="docs-lost__links">
          {links.map((l) => <li><a href={l.href}>{l.label}<small>{l.meta}</small></a></li>)}
        </ul>
      </nav>
    </div>
  </article>
</Base>
