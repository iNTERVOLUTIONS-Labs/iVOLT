---
// Generated at build time from packages/ivolt/CHANGELOG.md: the page and the file inside the
// published tarball are the same text, so they cannot drift apart between cycles.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { readChangelog } from "../lib/changelog.js";
const { intro, releases } = readChangelog();
---
<Base title="Changelog" description="Every iVOLT cycle from the first alpha to the 1.0 release candidate, generated at build time from the changelog that ships inside the package, with the dates of what is published and none invented for what is not.">
  <article class="docs-prose">
    <h1>Changelog</h1>
    <p>This page is generated at build time from <code>CHANGELOG.md</code> inside the package, so what you read here is exactly what ships in the tarball. Dates appear only for versions that are published; the rest say <em>unreleased</em> and no date is invented for them.</p>
    <div class="docs-meta docs-md" set:html={intro}></div>
    {releases.map((r, i) => (
      <Section title={r.title} id={r.id} num={i + 1}>
        <div class="docs-md" set:html={r.html}></div>
      </Section>
    ))}
  </article>
</Base>
