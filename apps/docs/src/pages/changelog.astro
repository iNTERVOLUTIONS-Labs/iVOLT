---
// Generated at build time from packages/ivolt/CHANGELOG.md: the page and the file inside the
// published tarball are the same text, so they cannot drift apart between cycles.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { readChangelog } from "../lib/changelog.js";
const { intro, releases } = readChangelog();
---
<Base title="Changelog: every iVOLT release" description="Every iVOLT release, version by version, taken straight from the changelog that ships inside the package, with the date of each published version.">
  <article class="docs-prose">
    <h1>Changelog</h1>
    <p>What you read here is the <code>CHANGELOG.md</code> that ships inside the package, so the page and the tarball can never drift apart. Published versions carry their date; anything still open says <em>unreleased</em>.</p>
    <div class="docs-meta docs-md" set:html={intro}></div>
    {releases.map((r, i) => (
      <Section title={r.title} id={r.id} num={i + 1}>
        <div class="docs-md" set:html={r.html}></div>
      </Section>
    ))}
  </article>
</Base>
