---
import Base from "../layouts/Base.astro";
import "../styles/home.css";
import Stage from "../components/Stage.astro";
import DeviceFrame from "../components/DeviceFrame.astro";
import Arcs from "../components/Arcs.astro";
import ThemeCut from "../components/ThemeCut.astro";
import { families } from "../i18n/en.js";
import { readFileSync, existsSync } from "node:fs";
import { gzipSync } from "node:zlib";
import { resolve, dirname } from "node:path";

// Real, build-time measurements from the built package (gzip level 9), so the facts on the page are never typed by hand.
let dir = process.cwd();
while (!existsSync(resolve(dir, "packages/ivolt/dist")) && dirname(dir) !== dir) dir = dirname(dir);
const dist = resolve(dir, "packages/ivolt/dist");
const version = JSON.parse(readFileSync(resolve(dir, "packages/ivolt/package.json"), "utf8")).version;
const kib = (rel) => existsSync(resolve(dist, rel)) ? (gzipSync(readFileSync(resolve(dist, rel)), { level: 9 }).length / 1024).toFixed(1) : null;
const facts = [
  { value: "0", label: "runtime dependencies" },
  { value: kib("css/ivolt.min.css") ? `${kib("css/ivolt.min.css")} KiB` : "—", label: "CSS, min + gzip" },
  { value: kib("js/ivolt.iife.min.js") ? `${kib("js/ivolt.iife.min.js")} KiB` : "—", label: "JS (IIFE), min + gzip" },
  { value: "3", label: "browser engines tested" },
];
const points = [
  { title: "It works before JavaScript does", text: "Links navigate, buttons act, native controls do their job. Content components need no script at all; interactive ones enhance markup that already works and put it back on destroy." },
  { title: "One token repaints the system", text: "Set --iv-color-primary or --iv-radius-md on any scope and every component follows. Light, dark and system themes ship built in, no JavaScript required." },
  { title: "JavaScript only where it earns it", text: "Idempotent init, clean destroy, cancelable events, keyboard patterns from the APG, no global observers, no eval, imports that are safe to render on the server." },
  { title: "Files, not a toolchain", text: "Layered and flat CSS, one sheet per component, ES modules with real exports, an IIFE with a single global, TypeScript types and the tokens as JSON." },
];
const panels = [
  { fixture: "carousel/photos", name: "Carousel", slug: "carousel", kind: "js" },
  { fixture: "form/float", name: "Form", slug: "form", kind: "css" },
  { fixture: "button/variants", name: "Button", slug: "button", kind: "css" },
  { fixture: "badge/variants", name: "Badge", slug: "badge", kind: "css" },
  { fixture: "alert/variants", name: "Alert", slug: "alert", kind: "css" },
  { fixture: "card/basic", name: "Card", slug: "card", kind: "css" },
  { fixture: "tabs/basic", name: "Tabs", slug: "tabs", kind: "js" },
  { fixture: "dialog/basic", name: "Dialog", slug: "dialog", kind: "js" },
  { fixture: "surfaces/glass", name: "Surfaces", slug: "surfaces", href: "/foundations/surfaces", kind: "css" },
  { fixture: "combobox/basic", name: "Combobox", slug: "combobox", kind: "js" },
];
const reel = [
  { fixture: "button/variants", name: "Button", slug: "button" },
  { fixture: "form/float", name: "Form", slug: "form" },
  { fixture: "tabs/basic", name: "Tabs", slug: "tabs" },
  { fixture: "dialog/basic", name: "Dialog", slug: "dialog" },
  { fixture: "combobox/basic", name: "Combobox", slug: "combobox" },
  { fixture: "carousel/photos", name: "Carousel", slug: "carousel" },
];
const site = Astro.site ? Astro.site.href.replace(/\/$/, "") : null;
// Structured data for the two things this page really is: the project's site and its source code.
// Only facts that can be checked in the repository — name, licence, repository, languages, version.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "iVOLT",
    ...(site ? { url: `${site}/` } : {}),
    inLanguage: "en",
    description: "Lightweight CSS framework and design system with accessible UI components, design tokens, dark mode and no runtime dependencies.",
    publisher: { "@type": "Organization", name: "iNTERVOLUTIONS" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "iVOLT",
    alternateName: "@intervolutions/ivolt",
    description: "A CSS, HTML and optional JavaScript frontend framework: 33 accessible UI components, a finite utility set, design tokens, light and dark themes and zero runtime dependencies.",
    codeRepository: "https://github.com/iNTERVOLUTIONS-Labs/iVOLT",
    programmingLanguage: ["CSS", "HTML", "JavaScript"],
    runtimePlatform: "Web browser",
    license: "https://opensource.org/licenses/MIT",
    version,
    ...(site ? { url: `${site}/` } : {}),
    author: { "@type": "Organization", name: "iNTERVOLUTIONS" },
  },
];
const components = Object.entries(families);
const recipes = [
  { slug: "studio", title: "Studio", text: "A creative studio: cinematic cover with parallax, a marquee, stacked service cards, a gallery with the viewer and a contact stepper." },
  { slug: "console", title: "Console", text: "A product console: megamenu, drawer, counted figures, a data table with filter and sort, a command palette and a validated form." },
  { slug: "journal", title: "Journal", text: "An editorial magazine: typography as the subject, a masonry of articles, a reading bar, notes in popovers and a printed layout that works." },
  { slug: "store", title: "Store", text: "A catalogue and a purchase that buys nothing: rich filters, a product carousel, a checkout stepper, a cart drawer and a confirmation dialog." },
];
---
<Base title="Lightweight CSS framework and design system" description="A lightweight CSS framework and design system: 33 accessible UI components, design tokens, dark mode, optional JavaScript and zero runtime dependencies." sidebar={false} bleed={true}>
  <section class="docs-hero" aria-labelledby="hero-title">
    <div class="docs-orbs" aria-hidden="true"><span class="docs-orb docs-orb--a"></span><span class="docs-orb docs-orb--b"></span></div>
    <Arcs />
    <div class="docs-hero__inner">
      <p class="docs-hero__kicker">v{version.replace(/-.*$/, "")} · MIT<span class="docs-hero__kicker-tail"> · <b>zero runtime dependencies</b></span></p>
      <h1 class="docs-hero__title" id="hero-title">
        <span class="docs-mask" style="--i:0"><span>The CSS framework</span></span>
        <span class="docs-mask" style="--i:1"><span>with no <em>build step</em><span class="docs-dot">.</span></span></span>
      </h1>
      <p class="docs-hero__lead">Thirty-three accessible components, a finite set of utilities and design tokens as the visual contract. Link one stylesheet and you are building — plain HTML, WordPress, Astro or any bundler.</p>
      <div class="docs-hero__actions">
        <a class="iv-button iv-button--primary iv-button--lg docs-magnetic" href="/getting-started">Get started</a>
        <a class="iv-button iv-button--secondary iv-button--lg docs-magnetic" href="/components/button">Browse the components</a>
      </div>
      <ul class="docs-facts">
        {facts.map((f) => <li class="docs-fact"><strong class="iv-count" data-iv-component="countup">{f.value}</strong><span>{f.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="why-title">
    <div class="docs-why">
      <div class="docs-why__head">
        <span class="docs-num">01 — Why</span>
        <span class="docs-why__figure" aria-hidden="true">01</span>
        <h2 class="docs-why__title" id="why-title">Learn the grammar once, use it everywhere.</h2>
        <p class="docs-why__lead">Every class, token, attribute and event follows the same prefixed contract, so what you learn on the first page still works on the last.</p>
      </div>
      <div class="docs-why__list">
        {points.map((p, i) => (
          <article class="docs-point docs-rail docs-reveal" style={`--i:${i}`}>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="docs-cabinet" aria-labelledby="components-title">
    <div class="docs-cabinet__head docs-wrap">
      <span class="docs-num">02 — Components</span>
      <h2 class="docs-why__title" id="components-title">Thirty-three components,<br>live on this page.</h2>
    </div>
    <div class="docs-wrap docs-showreel" data-showreel>
      <div class="docs-showreel__tabs" role="tablist" aria-label="Components on stage">
        {reel.map((r, i) => (
          <button class="docs-showreel__tab" type="button" role="tab" id={`reel-tab-${r.slug}`} aria-controls={`reel-panel-${r.slug}`} aria-selected={String(i === 0)} tabindex={i === 0 ? "0" : "-1"}>{r.name}</button>
        ))}
      </div>
      {reel.map((r, i) => (
        <div class="docs-showreel__panel" id={`reel-panel-${r.slug}`} role="tabpanel" aria-labelledby={`reel-tab-${r.slug}`} hidden={i !== 0}>
          <Stage name={r.fixture} title={r.name} primary={i === 0} minHeight="18rem" />
        </div>
      ))}
    </div>
    <div class="docs-wrap">
      <nav class="docs-families" aria-label="Components">
        {components.map(([c, kind]) => <a href={`/components/${c}`}>{c[0].toUpperCase() + c.slice(1)}<small>{kind}</small></a>)}
      </nav>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="themes-title">
    <div class="docs-cutsec">
      <div class="docs-cutsec__head docs-reveal">
        <span class="docs-num">03 — Themes</span>
        <h2 class="docs-why__title" id="themes-title">Dark mode is a scope, not a switch.</h2>
        <p>Set <code>data-iv-theme</code> on any element and that branch of the page changes theme. Explicit choices beat the system preference, scopes nest, and nothing needs storage or a script.</p>
        <pre class="docs-code" tabindex="0"><code>&lt;html data-iv-theme="system"&gt;
  &lt;section data-iv-theme="dark"&gt;
    &lt;aside data-iv-theme="light"&gt;…&lt;/aside&gt;
  &lt;/section&gt;
&lt;/html&gt;</code></pre>
      </div>
      <div class="docs-reveal" style="--i:1">
        <ThemeCut name="theme/nested" />
        <p class="docs-cutctl">
          <label for="docs-cut-range">Reveal the light scope</label>
          <input id="docs-cut-range" type="range" min="0" max="100" value="50" step="1">
        </p>
      </div>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="recipes-title">
    <div class="docs-reveal">
      <span class="docs-num">04 — Recipes</span>
      <h2 class="docs-why__title" id="recipes-title">Four complete pages, one package.</h2>
    </div>
    <div class="docs-recipes" style="margin-block-start:var(--docs-rhythm-md)">
      {recipes.map((r, i) => (
        <a class="docs-recipe docs-reveal" href={`/examples/${r.slug}/index.html`}>
          <div class="docs-recipe__frame iv-edge-near"><DeviceFrame slug={r.slug} title={r.title} device="desktop" eager={i === 0} /></div>
          <div class="docs-recipe__body">
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <span class="docs-recipe__go">Open the recipe <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="docs-invert" data-iv-theme="light" aria-labelledby="start-title">
    <div class="docs-wrap docs-invert__grid">
      <div class="docs-invert__head">
      <span class="docs-num">05 — Start</span>
      <h2 id="start-title">Two files and you are running.</h2>
      <p>Install it from npm, or copy <code>dist/</code> next to your page and link a stylesheet and a module. No configuration file, no plugin, no compiler. The starter and the four recipes are exactly this and nothing more.</p>
      </div>
      <div class="docs-invert__side">
      <pre class="docs-code" tabindex="0"><code>npm install @intervolutions/ivolt</code></pre>
      <pre class="docs-code" tabindex="0"><code>&lt;html class="iv-root" data-iv-theme="system"&gt;
  &lt;link rel="stylesheet" href="ivolt/css/ivolt.min.css"&gt;
  &lt;script type="module" src="ivolt/js/auto.js"&gt;&lt;/script&gt;</code></pre>
      <div class="iv-cluster">
        <a class="iv-button iv-button--primary iv-button--lg docs-magnetic" href="/getting-started">Install it now</a>
        <a class="iv-button iv-button--secondary iv-button--lg" href="/examples">Download the starter</a>
      </div>
      </div>
      <p class="docs-invert__foot">v{version} under MIT. What is public, and how it is allowed to change, is written down in <a href="/foundations/stability">stability</a>. The sizes above are measured from the files that ship, at build time.</p>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
</Base>
