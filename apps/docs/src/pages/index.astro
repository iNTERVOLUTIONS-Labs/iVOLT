---
import Base from "../layouts/Base.astro";
import Fixture from "../components/Fixture.astro";
import Arcs from "../components/Arcs.astro";
import ThemeCut from "../components/ThemeCut.astro";
import { families } from "../i18n/en.js";
import { readFileSync, existsSync } from "node:fs";
import { gzipSync } from "node:zlib";
import { resolve, dirname } from "node:path";

// Real, build-time measurements from the built package (gzip level 9), so the facts on the page are never typed by hand.
let dir = process.cwd();
while (!existsSync(resolve(dir, "packages/ivolt/dist")) && dirname(dir) !== dir) dir = dirname(dir);
const dist = resolve(dir, "packages/ivolt/dist");
const version = JSON.parse(readFileSync(resolve(dir, "packages/ivolt/package.json"), "utf8")).version;
const stage = /beta/.test(version) ? "beta" : /alpha/.test(version) ? "alpha" : "";
const kib = (rel) => existsSync(resolve(dist, rel)) ? (gzipSync(readFileSync(resolve(dist, rel)), { level: 9 }).length / 1024).toFixed(1) : null;
const facts = [
  { value: "0", label: "runtime dependencies" },
  { value: kib("css/ivolt.min.css") ? `${kib("css/ivolt.min.css")} KiB` : "—", label: "CSS, min + gzip" },
  { value: kib("js/ivolt.iife.min.js") ? `${kib("js/ivolt.iife.min.js")} KiB` : "—", label: "JS (IIFE), min + gzip" },
  { value: "3", label: "engines in the test suite" },
];
const points = [
  { title: "HTML first", text: "Links navigate, buttons act, native controls where they fit. Content components need no script; interactive ones enhance real markup and restore it on destroy." },
  { title: "Tokens as the API", text: "Override --iv-color-primary or --iv-radius-md on any scope and the whole system follows. Light, dark and system themes without JavaScript." },
  { title: "Optional, honest JS", text: "Idempotent init, clean destroy, cancelable events, keyboard patterns from the APG, no global observers, no eval, SSR-safe imports." },
  { title: "Ships as files", text: "Layered and flat CSS, per-component CSS, ES modules with real exports, an IIFE with one global, types and token JSON. Measured, not promised." },
];
const panels = [
  { fixture: "button/variants", name: "Button", slug: "button", kind: "css" },
  { fixture: "badge/variants", name: "Badge", slug: "badge", kind: "css" },
  { fixture: "alert/variants", name: "Alert", slug: "alert", kind: "css" },
  { fixture: "card/basic", name: "Card", slug: "card", kind: "css" },
  { fixture: "tabs/basic", name: "Tabs", slug: "tabs", kind: "js" },
  { fixture: "dialog/basic", name: "Dialog", slug: "dialog", kind: "js" },
  { fixture: "combobox/basic", name: "Combobox", slug: "combobox", kind: "js" },
];
const components = Object.entries(families);
const recipes = [
  { slug: "landing", title: "Business landing", text: "Hero, benefits, example pricing, FAQ accordion and a contact dialog." },
  { slug: "catalog", title: "Editorial catalogue", text: "Card grid with working filters and sorting, breadcrumb, badges, pagination and tabs." },
  { slug: "admin", title: "Admin panel", text: "Static sidebar drawer, KPIs, responsive table, form with toasts and a confirmation dialog." },
];
---
<Base title="The interface starts here" description="iVOLT is a hybrid CSS/HTML/JS frontend framework: semantic components, a finite utility set, design tokens and optional JavaScript. No runtime dependencies. Alpha." sidebar={false} bleed={true}>
  <section class="docs-hero" aria-labelledby="hero-title">
    <Arcs />
    <div class="docs-hero__inner">
      <p class="docs-hero__kicker">v{version.replace(/-.*$/, "")} {stage} · MIT · <b>zero runtime dependencies</b></p>
      <h1 class="docs-hero__title" id="hero-title">
        <span class="docs-mask" style="--i:0"><span>The interface</span></span>
        <span class="docs-mask" style="--i:1"><span>starts <em>here.</em></span></span>
      </h1>
      <p class="docs-hero__lead">Semantic components as the fast path, a finite utility set for composition, tokens as the visual contract and optional JavaScript for behaviour. From a plain <code>&lt;link&gt;</code> to WordPress, Astro or any bundler.</p>
      <div class="docs-hero__actions">
        <a class="iv-button iv-button--primary iv-button--lg docs-magnetic" href="/getting-started">Get started</a>
        <a class="iv-button iv-button--secondary iv-button--lg docs-magnetic" href="/components/button">Explore components</a>
      </div>
      <ul class="docs-facts">
        {facts.map((f) => <li class="docs-fact"><strong data-count>{f.value}</strong><span>{f.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="why-title">
    <div class="docs-why">
      <div class="docs-why__head">
        <span class="docs-num">01 — Why</span>
        <span class="docs-why__figure" aria-hidden="true">01</span>
        <h2 class="docs-why__title" id="why-title">One grammar for content, layout and behaviour.</h2>
        <p class="docs-why__lead">Every class, token, attribute and event follows the same prefixed contract, so what you learn on the first page works on the last.</p>
      </div>
      <div class="docs-why__list">
        {points.map((p, i) => (
          <article class="docs-point docs-rail docs-reveal" style={`--i:${i}`}>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="docs-cabinet" aria-labelledby="components-title">
    <div class="docs-cabinet__pin">
    <div class="docs-cabinet__head docs-wrap">
      <span class="docs-num">02 — Components</span>
      <h2 class="docs-why__title" id="components-title">Ten content families,<br>eight interactive ones.</h2>
    </div>
    <div class="docs-cabinet__sticky">
      <div class="docs-cabinet__track">
        {panels.map((p) => (
          <article class="docs-panel">
            <Fixture name={p.fixture} title={p.name} />
            <p class="docs-panel__meta"><a href={`/components/${p.slug}`}>{p.name}</a><small>{p.kind}</small></p>
          </article>
        ))}
      </div>
    </div>
    </div>
    <div class="docs-wrap">
      <nav class="docs-families" aria-label="Components">
        {components.map(([c, kind]) => <a href={`/components/${c}`}>{c[0].toUpperCase() + c.slice(1)}<small>{kind}</small></a>)}
      </nav>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="themes-title">
    <div class="docs-cutsec">
      <div class="docs-cutsec__head docs-reveal">
        <span class="docs-num">03 — Themes</span>
        <h2 class="docs-why__title" id="themes-title">Scopes, not switches.</h2>
        <p>Set <code>data-iv-theme</code> on any element. Explicit choices win over the system preference, scopes nest, and nothing needs storage or a script.</p>
        <pre class="docs-code" tabindex="0"><code>&lt;html data-iv-theme="system"&gt;
  &lt;section data-iv-theme="dark"&gt;
    &lt;aside data-iv-theme="light"&gt;…&lt;/aside&gt;
  &lt;/section&gt;
&lt;/html&gt;</code></pre>
      </div>
      <div class="docs-reveal" style="--i:1">
        <ThemeCut name="theme/nested" />
        <p class="docs-cutctl">
          <label for="docs-cut-range">Reveal the light scope</label>
          <input id="docs-cut-range" type="range" min="0" max="100" value="50" step="1">
        </p>
      </div>
    </div>
  </section>

  <section class="docs-section docs-wrap" aria-labelledby="recipes-title">
    <div class="docs-reveal">
      <span class="docs-num">04 — Recipes</span>
      <h2 class="docs-why__title" id="recipes-title">Three complete pages, one package.</h2>
    </div>
    <div class="docs-recipes" style="margin-block-start:clamp(3rem,7vh,5rem)">
      {recipes.map((r, i) => (
        <a class="docs-recipe docs-reveal" href={`/examples/${r.slug}/index.html`}>
          <div class="docs-recipe__frame"><iframe src={`/examples/${r.slug}/index.html`} title={`${r.title} recipe preview`} loading="lazy" tabindex="-1" aria-hidden="true" sandbox="allow-scripts allow-same-origin"></iframe></div>
          <div class="docs-recipe__body">
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <span class="docs-recipe__go">Open the recipe <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="docs-invert" data-iv-theme="light" aria-labelledby="start-title">
    <div class="docs-wrap">
      <span class="docs-num">05 — Start</span>
      <h2 id="start-title">Two files. No build step.</h2>
      <p>Build the package once, copy <code>dist/</code> next to your page and link a stylesheet and a module. The starter and the recipes are exactly this.</p>
      <pre class="docs-code" tabindex="0"><code>&lt;html class="iv-root" data-iv-theme="system"&gt;
  &lt;link rel="stylesheet" href="ivolt/css/ivolt.min.css"&gt;
  &lt;script type="module" src="ivolt/js/auto.js"&gt;&lt;/script&gt;</code></pre>
      <div class="iv-cluster">
        <a class="iv-button iv-button--primary iv-button--lg docs-magnetic" href="/getting-started">Read the getting started</a>
        <a class="iv-button iv-button--secondary iv-button--lg" href="/examples">Download the starter</a>
      </div>
      <p class="docs-invert__foot">Alpha: APIs may change before 0.1.0. Sizes above are measured at build time from the shipped files. No benchmarks against other frameworks.</p>
    </div>
  </section>
</Base>
